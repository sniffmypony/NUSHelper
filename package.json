{
  "name": "nushelper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:push": "drizzle-kit push",
    "format": "prettier --ignore-unknown --write src api tests supabase/migrations supabase/reminder-cron.sql.example README.md .env.example package.json tsconfig.json vercel.json",
    "format:check": "prettier --ignore-unknown --check src api tests supabase/migrations supabase/reminder-cron.sql.example README.md .env.example package.json tsconfig.json vercel.json",
    "lint": "eslint src api tests",
    "setup:webhook": "node scripts/set-webhook.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vercel/functions": "^3.11.1",
    "drizzle-orm": "^0.45.4",
    "google-auth-library": "^10.9.1",
    "googleapis": "^189.0.0",
    "luxon": "^3.7.2",
    "openai": "^7.55.0",
    "postgres": "^3.4.9",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/luxon": "^3.7.6",
    "@types/node": "^20.19.43",
    "@vercel/node": "^30.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "7.3.8",
    "vitest": "^4.1.12"
  }
}
