{
  "name": "nushelper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:push": "drizzle-kit push",
    "format": "prettier --ignore-unknown --write src api tests supabase/migrations supabase/reminder-cron.sql.example README.md .env.example package.json tsconfig.json vercel.json",
    "format:check": "prettier --ignore-unknown --check src api tests supabase/migrations supabase/reminder-cron.sql.example README.md .env.example package.json tsconfig.json vercel.json",
    "lint": "eslint src api tests",
    "setup:webhook": "node scripts/set-webhook.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vercel/functions": "^3.11.0",
    "drizzle-orm": "^0.33.0",
    "google-auth-library": "^10.3.0",
    "googleapis": "^160.0.0",
    "luxon": "^3.7.2",
    "openai": "^7.47.0",
    "postgres": "^3.4.4",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/luxon": "^3.7.1",
    "@types/node": "^20.14.15",
    "@vercel/node": "^3.2.0",
    "drizzle-kit": "^0.24.2",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.4"
  }
}
