# Copy to .env for local scripts. In production, set these in Vercel instead.
# Never commit real values.

# --- Required -----------------------------------------------------------

# From @BotFather after /newbot.
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# Your numeric Telegram user ID. Only this user can use the bot.
TELEGRAM_OWNER_ID=123456789

# Supabase: Project Settings > Database > Connection string ("Transaction" pooler).
DATABASE_URL=postgresql://postgres.yourproject:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Any random string; protects the Vercel cron endpoints.
CRON_SECRET=replace-with-a-random-string

# A different random string, shared only with the Supabase reminder cron.
REMINDER_DISPATCH_SECRET=replace-with-a-different-random-string

# NUSHelper is Singapore-only for now.
DEFAULT_TIMEZONE=Asia/Singapore

# --- AI assistant ---------------------------------------------------------
# Any OpenAI-compatible chat-completions API whose model supports tool
# calling (and image input, for photos). SOCLAAS_* names also work.
LLM_API_KEY=
LLM_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
LLM_MODEL=

# --- Optional: Canvas -----------------------------------------------------
# Canvas > Account > Settings > New access token. It can act as you.
# Leave empty to turn Canvas features off.
CANVAS_API_TOKEN=
CANVAS_BASE_URL=https://canvas.nus.edu.sg

# --- Optional: Google Calendar --------------------------------------------
# The one calendar the bot may use (your Gmail address for your main
# calendar). Leave empty to turn Calendar features off.
GOOGLE_CALENDAR_ID=

# Simple setup: base64 of a service-account JSON key. Share the calendar
# with the service account's email ("Make changes to events").
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# Advanced keyless setup instead of a JSON key: Vercel OIDC with Google
# Workload Identity Federation.
GCP_PROJECT_ID=
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
