{
  "regions": ["sin1"],
  "buildCommand": "pnpm --filter nushelper-web build",
  "outputDirectory": "web/dist",
  "functions": {
    "api/webhook.ts": {
      "maxDuration": 300
    },
    "api/web.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/web/:route*",
      "destination": "/api/web?route=:route*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 0 * * 1"
    },
    {
      "path": "/api/cron/canvas-deadlines",
      "schedule": "30 23 * * *"
    },
    {
      "path": "/api/cron/daily-morning",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/checkin-and-clear",
      "schedule": "0 15 * * *"
    }
  ]
}
